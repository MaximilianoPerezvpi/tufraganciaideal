# Todas son OPCIONALES. Se cargan en Vercel → Settings → Environment
# Variables (y después redeploy). En local: copiá este archivo a .env.local.

# Dominio público, sin barra final. Sin definir usa
# https://tufraganciaideal-self.vercel.app. Cambialo solo cuando tengas
# dominio propio funcionando.
NEXT_PUBLIC_DOMINIO=

# Google Analytics 4: el "ID de medición" (G-XXXXXXXXXX) de tu propiedad.
# Vacío = no se carga GA4.
NEXT_PUBLIC_GA4_ID=

# Meta Pixel: el ID numérico del Pixel (Administrador de eventos de Meta).
# Vacío = no se carga el Pixel.
NEXT_PUBLIC_META_PIXEL_ID=
